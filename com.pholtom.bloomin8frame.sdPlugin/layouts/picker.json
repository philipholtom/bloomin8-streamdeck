{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
    "id": "com.pholtom.bloomin8frame.picker",
    "items": [
        { "key": "icon", "type": "pixmap", "rect": [10, 24, 52, 52] },
        { "key": "label", "type": "text", "rect": [72, 8, 122, 20], "alignment": "left", "color": "#9a9a9a", "font": { "size": 14, "weight": 500 } },
        { "key": "value", "type": "text", "rect": [72, 32, 122, 32], "alignment": "left", "font": { "size": 22, "weight": 600 }, "text-overflow": "ellipsis" },
        { "key": "status", "type": "text", "rect": [72, 70, 122, 22], "alignment": "left", "color": "#b8b8b8", "font": { "size": 14, "weight": 400 }, "text-overflow": "ellipsis" }
    ]
}
