{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "Name": "BLOOMIN8 Frame",
    "Version": "1.3.0.0",
    "Author": "Philip Holtom",
    "Description": "Control a BLOOMIN8 e-ink photo frame from keys and dials: random photo, browse, previous, send from clipboard or Finder, fresh pictures from NASA, the Met and more, favourite or remove photos, Bluetooth wake, and live status with a low-battery warning.",
    "UUID": "com.pholtom.bloomin8frame",
    "Icon": "imgs/plugin/marketplace",
    "Category": "BLOOMIN8 Frame",
    "CategoryIcon": "imgs/plugin/icon",
    "CodePath": "bin/plugin.js",
    "SDKVersion": 2,
    "Software": {
        "MinimumVersion": "6.9"
    },
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "13"
        }
    ],
    "Nodejs": {
        "Version": "20",
        "Debug": "enabled"
    },
    "Actions": [
        {
            "Name": "Random Photo",
            "UUID": "com.pholtom.bloomin8frame.random",
            "Icon": "imgs/actions/random/icon",
            "Tooltip": "Show a random photo that's already on the frame",
            "PropertyInspectorPath": "ui/random.html",
            "Controllers": [
                "Keypad",
                "Encoder"
            ],
            "States": [
                {
                    "Image": "imgs/actions/random/key",
                    "ShowTitle": true,
                    "TitleAlignment": "bottom"
                }
            ],
            "Encoder": {
                "Icon": "imgs/actions/random/key",
                "layout": "layouts/picker.json",
                "TriggerDescription": {
                    "Rotate": "Choose gallery",
                    "Push": "Show a random photo",
                    "Touch": "Show a random photo"
                }
            }
        },
        {
            "Name": "Wake Frame",
            "UUID": "com.pholtom.bloomin8frame.wake",
            "Icon": "imgs/actions/wake/icon",
            "Tooltip": "Wake the frame's Wi-Fi over Bluetooth",
            "PropertyInspectorPath": "ui/frame.html",
            "Controllers": [
                "Keypad",
                "Encoder"
            ],
            "States": [
                {
                    "Image": "imgs/actions/wake/key",
                    "ShowTitle": true,
                    "TitleAlignment": "bottom"
                }
            ],
            "Encoder": {
                "Icon": "imgs/actions/wake/key",
                "layout": "layouts/picker.json",
                "TriggerDescription": {
                    "Push": "Wake the frame",
                    "Touch": "Wake the frame"
                }
            }
        },
        {
            "Name": "Frame Status",
            "UUID": "com.pholtom.bloomin8frame.status",
            "Icon": "imgs/actions/status/icon",
            "Tooltip": "Shows the photo on the frame and its battery; press to refresh",
            "PropertyInspectorPath": "ui/frame.html",
            "Controllers": [
                "Keypad",
                "Encoder"
            ],
            "States": [
                {
                    "Image": "imgs/actions/status/key",
                    "ShowTitle": false
                }
            ],
            "Encoder": {
                "Icon": "imgs/actions/status/key",
                "layout": "layouts/status.json",
                "TriggerDescription": {
                    "Push": "Refresh (waking if needed)",
                    "Touch": "Refresh (waking if needed)"
                }
            }
        },
        {
            "Name": "Fresh Picture",
            "UUID": "com.pholtom.bloomin8frame.generated",
            "Icon": "imgs/actions/generated/icon",
            "Tooltip": "Fetch a picture from NASA, the Met, Wikipedia and more, and show it",
            "PropertyInspectorPath": "ui/generated.html",
            "Controllers": [
                "Keypad",
                "Encoder"
            ],
            "States": [
                {
                    "Image": "imgs/actions/generated/key",
                    "ShowTitle": true,
                    "TitleAlignment": "bottom"
                }
            ],
            "Encoder": {
                "Icon": "imgs/actions/generated/key",
                "layout": "layouts/picker.json",
                "TriggerDescription": {
                    "Rotate": "Choose source",
                    "Push": "Fetch and show",
                    "Touch": "Fetch and show"
                }
            }
        },
        {
            "Name": "Previous Photo",
            "UUID": "com.pholtom.bloomin8frame.previous",
            "Icon": "imgs/actions/previous/icon",
            "Tooltip": "Go back to the photos the frame showed before",
            "PropertyInspectorPath": "ui/frame.html",
            "Controllers": [
                "Keypad",
                "Encoder"
            ],
            "States": [
                {
                    "Image": "imgs/actions/previous/key",
                    "ShowTitle": false,
                    "TitleAlignment": "bottom"
                }
            ],
            "Encoder": {
                "Icon": "imgs/actions/previous/key",
                "layout": "layouts/photo.json",
                "TriggerDescription": {
                    "Rotate": "Look back through history",
                    "Push": "Show it",
                    "Touch": "Show it"
                }
            }
        },
        {
            "Name": "Browse Gallery",
            "UUID": "com.pholtom.bloomin8frame.browse",
            "Icon": "imgs/actions/browse/icon",
            "Tooltip": "Turn to flick through a gallery's photos, push to show one",
            "PropertyInspectorPath": "ui/browse.html",
            "Controllers": [
                "Encoder"
            ],
            "States": [
                {
                    "Image": "imgs/actions/browse/key",
                    "ShowTitle": true
                }
            ],
            "Encoder": {
                "Icon": "imgs/actions/browse/key",
                "layout": "layouts/photo.json",
                "TriggerDescription": {
                    "Rotate": "Browse photos",
                    "Push": "Show this photo",
                    "Touch": "Show (hold: next gallery)",
                    "LongTouch": "Next gallery"
                }
            }
        },
        {
            "Name": "Remove from Frame",
            "UUID": "com.pholtom.bloomin8frame.remove",
            "Icon": "imgs/actions/remove/icon",
            "Tooltip": "Delete the photo that's showing (press twice to confirm)",
            "PropertyInspectorPath": "ui/frame.html",
            "Controllers": [
                "Keypad",
                "Encoder"
            ],
            "States": [
                {
                    "Image": "imgs/actions/remove/key",
                    "ShowTitle": false,
                    "TitleAlignment": "bottom"
                }
            ],
            "Encoder": {
                "Icon": "imgs/actions/remove/key",
                "layout": "layouts/photo.json",
                "TriggerDescription": {
                    "Push": "Push twice to delete",
                    "Touch": "Tap twice to delete"
                }
            }
        },
        {
            "Name": "Send to Frame",
            "UUID": "com.pholtom.bloomin8frame.send",
            "Icon": "imgs/actions/send/icon",
            "Tooltip": "Send the clipboard's image, or the image selected in Finder",
            "PropertyInspectorPath": "ui/send.html",
            "Controllers": [
                "Keypad",
                "Encoder"
            ],
            "States": [
                {
                    "Image": "imgs/actions/send/key",
                    "ShowTitle": true,
                    "TitleAlignment": "bottom"
                }
            ],
            "Encoder": {
                "Icon": "imgs/actions/send/key",
                "layout": "layouts/picker.json",
                "TriggerDescription": {
                    "Rotate": "Clipboard or Finder",
                    "Push": "Send",
                    "Touch": "Send"
                }
            }
        },
        {
            "Name": "Favourite This",
            "UUID": "com.pholtom.bloomin8frame.favourite",
            "Icon": "imgs/actions/favourite/icon",
            "Tooltip": "Copy the photo that's showing into your Favourites gallery",
            "PropertyInspectorPath": "ui/favourite.html",
            "Controllers": [
                "Keypad",
                "Encoder"
            ],
            "States": [
                {
                    "Image": "imgs/actions/favourite/key",
                    "ShowTitle": false
                }
            ],
            "Encoder": {
                "Icon": "imgs/actions/favourite/key",
                "layout": "layouts/photo.json",
                "TriggerDescription": {
                    "Push": "Save to favourites",
                    "Touch": "Save to favourites"
                }
            }
        }
    ]
}